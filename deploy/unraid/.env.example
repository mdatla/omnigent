# Copy to .env next to docker-compose.yaml and fill in. Never commit .env.
#
#   cp .env.example .env
#   sed -i "s|^OMNIGENT_ACCOUNTS_COOKIE_SECRET=.*|OMNIGENT_ACCOUNTS_COOKIE_SECRET=$(openssl rand -hex 32)|" .env
#
# Values marked REQUIRED have no safe default; compose refuses to start without
# them rather than booting a half-configured server.

# ── images ──────────────────────────────────────────────────────────────────
# GHCR namespace that receives the fork's images. Must match the repo owner
# that owns the packages, or be overridden if you publish elsewhere.
OMNIGENT_ORG=mdatla

# Image tag for server + host + sync sidecar.
#   latest            follow the fork's daily build (normal choice)
#   sha-<12 chars>    pin to one exact build (reproducible; use for rollback)
# A single tag for the whole stack keeps the server and host on the same
# upstream commit, which matters: the host's usage baseline contract and the
# server's baseline plumbing evolve together.
OMNIGENT_TAG=latest

# ── public identity ─────────────────────────────────────────────────────────
# Public URL the tunnel serves. The accounts cookie domain and login redirect
# are derived from it, so it must match the Cloudflare hostname exactly.
# REQUIRED
OMNIGENT_PUBLIC_URL=https://omni.mdatla.us

# URL the host container dials to reach the server.
#   https://omni.mdatla.us   goes out through the tunnel (current behaviour)
#   http://omnigent:8000     stays on the compose network (faster, no tunnel
#                            round-trip; use once the tunnel is verified)
# REQUIRED
OMNIGENT_SERVER_URL=https://omni.mdatla.us

# ── auth (accounts mode) ────────────────────────────────────────────────────
# REQUIRED. Session cookie signing key. Generate once and keep it: changing it
# logs every user out.  openssl rand -hex 32
OMNIGENT_ACCOUNTS_COOKIE_SECRET=

# Optional: create the first admin with this password instead of the web form.
# Leave blank to use the "No admin yet" browser flow.
OMNIGENT_ACCOUNTS_INIT_ADMIN_PASSWORD=

# accounts (built-in username/password) or oidc (needs OMNIGENT_OIDC_* vars,
# see upstream deploy/docker/.env.example).
OMNIGENT_AUTH_PROVIDER=accounts

# ── cloudflare tunnel ───────────────────────────────────────────────────────
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> (tunnel) ->
# Configure -> install connector. REQUIRED.
# The tunnel's public hostname ingress must point at http://omnigent:8000.
CLOUDFLARED_TUNNEL_TOKEN=

# ── optional ────────────────────────────────────────────────────────────────
# Loopback port for local curl/diagnostics only (never exposed publicly).
OMNIGENT_BIND_PORT=8000

# Vault path INSIDE the container (the /root bind mount makes host and
# container paths identical).
OBSIDIAN_VAULT=/root/vaults/main_v2

# Comma-separated feature overrides: name enables, -name disables.
OMNIGENT_FEATURES=
